PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=survey_system
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
